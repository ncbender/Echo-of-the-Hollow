[node name="Ledger" type="Area2D" parent="EmbersOfShelter"]
position = Vector2(-200, 330)
script = ExtResource("12_read")
persistent_id = &"shelter_ledger"
title = "Keeper's Ledger"
text = "Names, day after day, in the same careful hand: those who came, those who left. Near the end: When the cold came we brewed the ember draught - two leaves of duskleaf, a sliver of timber, and patience. It kept the hands steady and the blades sharp. What we could spare is in the hearth box."
event_id = &"interact:shelter_ledger"

