[node name="ChapelWaystone" type="Area2D" parent="."]
position = Vector2(290, 0)
script = ExtResource("12_read")
persistent_id = &"chapel_old_stone"
title = "Chapel Waystone"
verb = "Examine"
text = "Roots have curled around the old waystone, tight as a closing hand. The stone is cold and silent. Every root that holds it strains toward the east."
look = 4
event_id = &"interact:chapel_waystone"

[node name="CollisionShape2D" type="CollisionShape2D" parent="ChapelWaystone"]
shape = SubResource("Circle_use")

[node name="FadedNote" type="Area2D" parent="."]
position = Vector2(230, 430)
script = ExtResource("12_read")
persistent_id = &"chapel_faded_note"
title = "Faded Note"
text = "Kept the fire low and the door barred, as those before us did. Left what bread we could spare for whoever comes next."

[node name="CollisionShape2D" type="CollisionShape2D" parent="FadedNote"]
shape = SubResource("Circle_use")

[node name="Lore" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Headstone" type="Area2D" parent="Lore"]
position = Vector2(-610, -60)
script = ExtResource("12_read")
persistent_id = &"chapel_headstone"
title = "Weathered Headstone"
verb = "Read"
text = "The names have worn away. Only the last line is still sharp, as if someone recut it often: SHELTER WAS GIVEN HERE."
look = 2

[node name="CollisionShape2D" type="CollisionShape2D" parent="Lore/Headstone"]
shape = SubResource("Circle_use")

[node name="CrackedBell" type="Area2D" parent="Lore"]
position = Vector2(-300, -440)
script = ExtResource("12_read")
persistent_id = &"chapel_cracked_bell"
title = "Cracked Bell"
verb = "Examine"
text = "The chapel bell lies where the tower dropped it, split down one side. Roots have grown through the crack and out again."
look = 2

[node name="CollisionShape2D" type="CollisionShape2D" parent="Lore/CrackedBell"]
shape = SubResource("Circle_use")

