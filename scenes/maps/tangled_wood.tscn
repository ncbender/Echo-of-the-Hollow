[node name="RootsKeep" type="Node2D" parent="."]
y_sort_enabled = true

[node name="KnottedMarker" type="Area2D" parent="RootsKeep"]
position = Vector2(-850, -30)
script = ExtResource("12_read")
persistent_id = &"roots_keep_marker"
title = "Knotted Marker"
verb = "Examine"
text = "A stone half swallowed by roots. Someone carved a sign into it long ago: three lines, bent like the roots themselves - one reaching north along the old path, one sinking south into the hollow, one leaning toward the sunken grove."
look = 2
event_id = &"interact:roots_keep_marker"

[node name="CollisionShape2D" type="CollisionShape2D" parent="RootsKeep/KnottedMarker"]
shape = SubResource("Circle_use")

[node name="MarkNorth" type="Area2D" parent="RootsKeep"]
position = Vector2(490, -700)
script = ExtResource("12_read")
persistent_id = &"roots_keep_mark_1"
title = "Carved Root"
verb = "Examine"
text = "The three-lined sign again, cut into a root as thick as a man. The cut has healed over, and been cut again. Far below, the hollow waits."
look = 3
event_id = &"interact:roots_keep_mark"

[node name="CollisionShape2D" type="CollisionShape2D" parent="RootsKeep/MarkNorth"]
shape = SubResource("Circle_use")

[node name="MarkHollow" type="Area2D" parent="RootsKeep"]
position = Vector2(330, 690)
script = ExtResource("12_read")
persistent_id = &"roots_keep_mark_2"
title = "Carved Root"
verb = "Examine"
text = "The sign, scratched into the root beside the gnawed wood. Someone came back here more than once. The roots run on west, toward the sunken grove."
look = 3
event_id = &"interact:roots_keep_mark"

[node name="CollisionShape2D" type="CollisionShape2D" parent="RootsKeep/MarkHollow"]
shape = SubResource("Circle_use")

[node name="MarkGrove" type="Area2D" parent="RootsKeep"]
