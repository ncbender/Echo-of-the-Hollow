[node name="TwistedRoots" type="Area2D" parent="."]
position = Vector2(250, 0)
script = ExtResource("12_read")
persistent_id = &"tangled_twisted_roots"
title = "Twisted Roots"
verb = "Examine"
text = "Thick roots have torn up through the ground here, the earth around them still loose and damp. Every one of them bends the same way - east, deeper into the woods - as if something had dragged them there in the night."
look = 3
event_id = &"interact:tangled_roots"

[node name="CollisionShape2D" type="CollisionShape2D" parent="TwistedRoots"]
shape = SubResource("Circle_use")

