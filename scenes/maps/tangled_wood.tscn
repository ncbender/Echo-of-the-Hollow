[node name="SwallowedCart" type="Area2D" parent="Lore"]
position = Vector2(-40, -772)
script = ExtResource("12_read")
persistent_id = &"tangled_swallowed_cart"
title = "Swallowed Cart"
verb = "Examine"
text = "A handcart, or what is left of one. Roots have grown up through its bed and lifted it off the ground, wheels and all. Whatever it carried is long gone."
look = 1

[node name="CollisionShape2D" type="CollisionShape2D" parent="Lore/SwallowedCart"]
shape = SubResource("Circle_use")

[node name="SunkenStones" type="Area2D" parent="Lore"]
