[node name="ScratchedTally" type="Area2D" parent="."]
position = Vector2(296, -168)
script = ExtResource("10_read")
persistent_id = &"wardens_rest_tally"
title = "Scratched Tally"
verb = "Examine"
text = "Rows of tally marks are scratched into the stone, one row after another. The last row was never finished."
look = 2

