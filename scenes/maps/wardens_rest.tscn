[node name="SplitWatchstone" type="Area2D" parent="AfterSentinel"]
position = Vector2(100, -128)
script = ExtResource("10_read")
persistent_id = &"wardens_rest_watchstone"
title = "Split Watchstone"
verb = "Examine"
text = "An old marker stone of the watch post, split from top to bottom. Roots have forced their way up through the crack. Like every root since the Tangled Wood, they lean east."
look = 3
