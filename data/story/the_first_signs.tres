[gd_resource type="Resource" script_class="StoryQuestDefinition" format=3]

[ext_resource type="Script" path="res://scripts/rpg/quests/story_quest_definition.gd" id="1_quest"]
[ext_resource type="Script" path="res://scripts/rpg/quests/story_step.gd" id="2_step"]
[ext_resource type="Script" path="res://scripts/rpg/quests/story_objective.gd" id="3_obj"]

[sub_resource type="Resource" id="O_east"]
script = ExtResource("3_obj")
event_id = &"enter:tangled_wood"
description = "Find the way east of the Whisper Forest"

[sub_resource type="Resource" id="S_east"]
script = ExtResource("2_step")
description = "Edrin warned that the roots under the Hollowwood are moving. Follow the Whisper Forest east, deeper into the woods."
objectives = Array[ExtResource("3_obj")]([SubResource("O_east")])
completion_flag = &"chapter1.tangled_wood_reached"

[sub_resource type="Resource" id="O_roots"]
script = ExtResource("3_obj")
event_id = &"interact:tangled_roots"
description = "Examine the twisted roots"
cumulative = true

[sub_resource type="Resource" id="S_roots"]
script = ExtResource("2_step")
description = "The roots grow wild in the Tangled Wood. Search it for a sign of what moves them."
objectives = Array[ExtResource("3_obj")]([SubResource("O_roots")])
completion_flag = &"chapter1.roots_examined"

[sub_resource type="Resource" id="O_chapel"]
script = ExtResource("3_obj")
event_id = &"interact:chapel_waystone"
description = "Examine the old waystone at the chapel"
cumulative = true

[sub_resource type="Resource" id="S_deeper"]
script = ExtResource("2_step")
description = "The roots all bend the same way, east past the Tangled Wood. Follow them and find what they are pulling toward."
objectives = Array[ExtResource("3_obj")]([SubResource("O_chapel")])
completion_flag = &"chapter1.chapel_waystone_examined"

[sub_resource type="Resource" id="S_beyond"]
script = ExtResource("2_step")
description = "Even the roots around the old waystone pull further east, toward a way choked with stone. Your journey continues in a future update."

[resource]
script = ExtResource("1_quest")
id = &"the_first_signs"
display_name = "The First Signs"
chapter = "The Roots Remember"
description = "Main quest, chapter one. Whatever walks the woods is drawing closer to Haven."
steps = Array[ExtResource("2_step")]([SubResource("S_east"), SubResource("S_roots"), SubResource("S_deeper"), SubResource("S_beyond")])
open_ended = true
