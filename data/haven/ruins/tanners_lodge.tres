[resource]
script = ExtResource("1_ruin")
id = &"tanners_lodge"
display_name = "The Tanner's Lodge"
description = "Drying racks without hides and a cracked tanning vat. Its workbench still serves while the lodge lies in ruins."
restorable = true
condition = SubResource("C_haven")
costs = Array[ExtResource("2_cost")]([SubResource("R_timber"),SubResource("R_stone"),SubResource("R_raw_hide")])
profession_id = &"leatherworking"
footprint = Vector2(64, 42)
restored_text = "Walls patched, a new roof and a sound tanning vat: the lodge is dry again and its racks hold fresh hides."
revitalize_costs = Array[ExtResource("2_cost")]([SubResource("V_oak_plank"),SubResource("V_cured_leather"),SubResource("V_iron_ingot")])
revitalized_text = "Lantern light, hides hanging in neat rows and a tool rack for every knife and awl: a tanner's lodge as it once was."
