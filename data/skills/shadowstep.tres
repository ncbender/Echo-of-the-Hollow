[resource]
script = ExtResource("5_s3obu")
id = &"shadowstep"
class_id = &"shadowrunner"
display_name = "Shadowstep"
description = "Step through the shadows to an enemy in front of you (up to 130 px) and expose a Weak Point. Needs a reachable target - without one nothing is spent. Not a dash: no dash charge, no invulnerability. For 3 s afterwards your critical hit chance is 15% higher."
