[resource]
script = ExtResource("1_building")
id = &"smithy"
display_name = "Smithy"
description = "The rekindled forge of Haven. Turns ore and timber into simple weapons."
costs = Array[ExtResource("2_cost")]([SubResource("Cost_timber"), SubResource("Cost_stone"), SubResource("Cost_ore")])
size = 1
color = Color(0.42, 0.4, 0.42, 1)
unique = true
scene = ExtResource("3_scene")
recipes = Array[ExtResource("4_recipe")]([SubResource("Recipe_sword")])
crafting_station = true
